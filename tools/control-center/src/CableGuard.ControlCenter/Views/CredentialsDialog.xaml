<Window x:Class="CableGuard.ControlCenter.Views.CredentialsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camera credentials"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#FF1B1E24" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock x:Name="HeaderText" FontSize="15" FontWeight="SemiBold" Foreground="#FFDDE1E7" Margin="0,0,0,4"/>
        <TextBlock x:Name="RefText" FontSize="11" Foreground="#FF9AA3AF" Margin="0,0,0,12"/>

        <TextBlock Text="Username" Foreground="#FFDDE1E7"/>
        <TextBox x:Name="UsernameBox" Margin="0,2,0,10" Background="#FF2C313A" Foreground="#FFDDE1E7"/>

        <TextBlock Text="Password" Foreground="#FFDDE1E7"/>
        <PasswordBox x:Name="PasswordBox" Margin="0,2,0,4" Background="#FF2C313A" Foreground="#FFDDE1E7"/>
        <TextBlock x:Name="PasswordHint" FontSize="11" Foreground="#FF9AA3AF" Margin="0,0,0,12"/>

        <TextBlock Text="Uloženo do Windows Credential Manageru. Heslo se nikdy neukládá do cameras.json, logů ani Gitu."
                   FontSize="11" Foreground="#FF9AA3AF" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Uložit" Width="90" Margin="0,0,8,0" Click="Save_Click"
                    Background="#FF2E7D32" Foreground="#FFDDE1E7"/>
            <Button Content="Zrušit" Width="90" IsCancel="True"
                    Background="#FF2C313A" Foreground="#FFDDE1E7"/>
        </StackPanel>
    </StackPanel>
</Window>
