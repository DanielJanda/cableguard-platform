<Window x:Class="CableGuard.ControlCenter.Views.CameraEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit camera" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" Background="#FF1B1E24" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="Název" Foreground="#FFDDE1E7"/>
        <TextBox x:Name="NameBox" Margin="0,2,0,8" Background="#FF2C313A" Foreground="#FFDDE1E7"/>
        <TextBlock Text="camera_id" Foreground="#FFDDE1E7"/>
        <TextBox x:Name="IdBox" Margin="0,2,0,8" Background="#FF2C313A" Foreground="#FFDDE1E7"/>
        <TextBlock Text="IP / Host" Foreground="#FFDDE1E7"/>
        <TextBox x:Name="HostBox" Margin="0,2,0,8" Background="#FF2C313A" Foreground="#FFDDE1E7"/>
        <TextBlock Text="RTSP port" Foreground="#FFDDE1E7"/>
        <TextBox x:Name="PortBox" Margin="0,2,0,8" Background="#FF2C313A" Foreground="#FFDDE1E7"/>
        <TextBlock Text="Profil / Channel" Foreground="#FFDDE1E7"/>
        <TextBox x:Name="ProfileBox" Margin="0,2,0,8" Background="#FF2C313A" Foreground="#FFDDE1E7"/>
        <TextBlock Text="Transport (tcp/udp)" Foreground="#FFDDE1E7"/>
        <TextBox x:Name="TransportBox" Margin="0,2,0,8" Background="#FF2C313A" Foreground="#FFDDE1E7"/>
        <TextBlock Text="MediaMTX path (dedicated / preview)" Foreground="#FFDDE1E7"/>
        <TextBox x:Name="PathBox" Margin="0,2,0,8" Background="#FF2C313A" Foreground="#FFDDE1E7"/>
        <TextBlock Text="Credential ref" Foreground="#FFDDE1E7"/>
        <TextBox x:Name="CredBox" Margin="0,2,0,8" Background="#FF2C313A" Foreground="#FFDDE1E7"/>
        <TextBlock Text="site_id / station_id" Foreground="#FFDDE1E7"/>
        <StackPanel Orientation="Horizontal" Margin="0,2,0,12">
            <TextBox x:Name="SiteBox" Width="200" Background="#FF2C313A" Foreground="#FFDDE1E7"/>
            <TextBox x:Name="StationBox" Width="200" Margin="8,0,0,0" Background="#FF2C313A" Foreground="#FFDDE1E7"/>
        </StackPanel>
        <TextBlock Text="Heslo se sem neukládá — použij Credentials v kartě kamery (Windows Credential Manager)."
                   FontSize="11" Foreground="#FF9AA3AF" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="SAVE" Width="90" Margin="0,0,8,0" Click="Save_Click" Background="#FF2E7D32" Foreground="#FFDDE1E7"/>
            <Button Content="Cancel" Width="90" IsCancel="True" Background="#FF2C313A" Foreground="#FFDDE1E7"/>
        </StackPanel>
    </StackPanel>
</Window>
