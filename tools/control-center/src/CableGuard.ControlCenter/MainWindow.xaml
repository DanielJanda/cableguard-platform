<Window x:Class="CableGuard.ControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CableGuard Admin — Control Center"
        Width="1060" Height="720"
        Background="#FF1B1E24"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFDDE1E7"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="#FF2C313A"/>
            <Setter Property="Foreground" Value="#FFDDE1E7"/>
            <Setter Property="BorderBrush" Value="#FF444B57"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,6"/>
        </Style>
        <Style x:Key="StatusBadge" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FF9AA3AF"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="RUNNING">
                    <Setter Property="Foreground" Value="#FF4CAF50"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="STOPPED">
                    <Setter Property="Foreground" Value="#FF9AA3AF"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="DEGRADED">
                    <Setter Property="Foreground" Value="#FFFFB300"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="FAULT">
                    <Setter Property="Foreground" Value="#FFE53935"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="LIVE">
                    <Setter Property="Foreground" Value="#FF4CAF50"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="OFFLINE">
                    <Setter Property="Foreground" Value="#FFE53935"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <TabControl Background="#FF1B1E24" BorderThickness="0">

        <!-- ============ OVERVIEW ============ -->
        <TabItem Header="Overview">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Text="SYSTEM " FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SystemStatus}" FontSize="30" FontWeight="Bold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#FF9AA3AF"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SystemStatus}" Value="READY">
                                        <Setter Property="Foreground" Value="#FF4CAF50"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SystemStatus}" Value="DEGRADED">
                                        <Setter Property="Foreground" Value="#FFFFB300"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SystemStatus}" Value="FAULT">
                                        <Setter Property="Foreground" Value="#FFE53935"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding Services}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="16"/>
                                <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="16" Style="{StaticResource StatusBadge}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="12" Foreground="#FF9AA3AF" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,18,0,0">
                    <Button Content="START ALL" FontWeight="Bold" Padding="18,8" Background="#FF2E7D32"
                            Command="{Binding StartAllCommand}"/>
                    <Button Content="STOP ALL" Padding="18,8" Background="#FF8E2A2A"
                            Command="{Binding StopAllCommand}"/>
                    <Button Content="OPEN DASHBOARD" Padding="18,8" Command="{Binding OpenDashboardCommand}"/>
                    <Button Content="OPEN KIOSK" Padding="18,8" Command="{Binding OpenKioskCommand}"/>
                    <Button Content="Refresh" Padding="18,8" Command="{Binding RefreshCommand}"/>
                </StackPanel>

                <Border Grid.Row="3" Margin="0,14,0,0" Background="#FF14161A" CornerRadius="4" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding StartAllProgress}" FontFamily="Consolas" FontSize="12"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </TabItem>

        <!-- ============ SERVICES ============ -->
        <TabItem Header="Services">
            <ItemsControl ItemsSource="{Binding Services}" Margin="16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FF23272F" CornerRadius="6" Padding="12" Margin="0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="15" VerticalAlignment="Center"
                                           Style="{StaticResource StatusBadge}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="12" Foreground="#FF9AA3AF"
                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <Button Content="Start" Command="{Binding StartCommand}"/>
                                    <Button Content="Stop" Command="{Binding StopCommand}"/>
                                    <Button Content="Restart" Command="{Binding RestartCommand}"/>
                                    <Button Content="Logs" Command="{Binding LogsCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </TabItem>

        <!-- ============ CAMERAS ============ -->
        <TabItem Header="Cameras" DataContext="{Binding Cameras}">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="{Binding RegistryStatus}" VerticalAlignment="Center" Foreground="#FF9AA3AF"/>
                    <Button Content="Reload" Command="{Binding ReloadCommand}" Margin="12,0"/>
                </StackPanel>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Cameras}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FF23272F" CornerRadius="6" Padding="12" Margin="0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Status}" FontSize="15" Margin="14,0,0,0"
                                                       Style="{StaticResource StatusBadge}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="#FF9AA3AF" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding TestResult}" FontSize="12" Foreground="#FF7FB2E5" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Test connection" Command="{Binding TestCommand}"/>
                                        <Button Content="Preview" Command="{Binding PreviewCommand}"/>
                                        <Button Content="{Binding EnableLabel}" Command="{Binding ToggleEnabledCommand}"/>
                                        <Button Content="Credentials" Command="{Binding EditCredentialsCommand}"/>
                                        <Button Content="Set as primary" Command="{Binding SetPrimaryCommand}" Background="#FF3A5A8C"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Grid.Row="2" Background="#FF14161A" CornerRadius="4" Padding="10" Margin="0,8,0,0"
                        MaxHeight="140">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding SwitchProgress}" FontFamily="Consolas" FontSize="12"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </TabItem>

        <!-- ============ LOGS ============ -->
        <TabItem Header="Logs" DataContext="{Binding Logs}">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Zdroj:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="180" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"
                              DisplayMemberPath="Name"/>
                    <TextBlock Text="Filtr:" VerticalAlignment="Center" Margin="14,0,6,0"/>
                    <TextBox Width="200" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             Background="#FF2C313A" Foreground="#FFDDE1E7" BorderBrush="#FF444B57"/>
                    <CheckBox Content="Errors only" IsChecked="{Binding ErrorsOnly}" Foreground="#FFDDE1E7"
                              VerticalAlignment="Center" Margin="14,0,0,0"/>
                    <CheckBox Content="Live tail" IsChecked="{Binding LiveTail}" Foreground="#FFDDE1E7"
                              VerticalAlignment="Center" Margin="14,0,0,0"/>
                    <Button Content="Clear view" Command="{Binding ClearViewCommand}" Margin="14,0,0,0"/>
                    <Button Content="Open folder" Command="{Binding OpenFolderCommand}"/>
                </StackPanel>
                <TextBox Grid.Row="1" Text="{Binding VisibleText, Mode=OneWay}" IsReadOnly="True"
                         FontFamily="Consolas" FontSize="12"
                         Background="#FF14161A" Foreground="#FFC9D1D9" BorderThickness="0"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextChanged="LogBox_TextChanged"/>
            </Grid>
        </TabItem>

        <!-- ============ SETTINGS ============ -->
        <TabItem Header="Settings" DataContext="{Binding Settings}">
            <StackPanel Margin="16" MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock Text="Cesty a runtime konfigurace" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TextBlock Text="Platform repo:"/>
                <TextBox Text="{Binding PlatformRoot}" Margin="0,2,0,8" Background="#FF2C313A" Foreground="#FFDDE1E7"/>
                <TextBlock Text="Monitor repo:"/>
                <TextBox Text="{Binding MonitorRoot}" Margin="0,2,0,8" Background="#FF2C313A" Foreground="#FFDDE1E7"/>
                <TextBlock Text="Detector repo:"/>
                <TextBox Text="{Binding DetectorRoot}" Margin="0,2,0,8" Background="#FF2C313A" Foreground="#FFDDE1E7"/>
                <TextBlock Text="LAN host:"/>
                <TextBox Text="{Binding LanHost}" Margin="0,2,0,8" Background="#FF2C313A" Foreground="#FFDDE1E7"/>
                <TextBlock Text="Produkční stream (MediaMTX path):"/>
                <TextBox Text="{Binding ProductionStream}" Margin="0,2,0,8" Background="#FF2C313A" Foreground="#FFDDE1E7"/>
                <TextBlock Text="Detector start script (prázdné = NOT CONFIGURED do Phase 3):"/>
                <TextBox Text="{Binding DetectorStartCommand}" Margin="0,2,0,8" Background="#FF2C313A" Foreground="#FFDDE1E7"/>
                <Button Content="Uložit" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Padding="18,6"/>
                <TextBlock Text="{Binding SaveResult}" Margin="0,8,0,0" Foreground="#FF7FB2E5"/>
            </StackPanel>
        </TabItem>

    </TabControl>
</Window>
