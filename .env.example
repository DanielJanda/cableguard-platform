# CableGuard Platform – local development
CABLEGUARD_ENV=development
CABLEGUARD_HOST=127.0.0.1
CABLEGUARD_PORT=8000

# SQLite path relative to repo root
CABLEGUARD_DATABASE_URL=sqlite:///./data/cableguard.sqlite3

# Ingest API key for POST /api/v1/events and /api/v1/heartbeats
# REQUIRED: replace the placeholder with a unique random string before starting Event Core.
# Never commit the real value (.env is gitignored).
CABLEGUARD_INGEST_API_KEY=change-me-local-dev-key

# Kiosk API key for POST /api/v1/events/{event_id}/acknowledge
# REQUIRED: replace the placeholder with a unique random string (must match monitor .env.local).
# Server-side only (Event Core + Vite BFF). Never expose as VITE_* or in the React bundle.
CABLEGUARD_KIOSK_API_KEY=change-me-local-kiosk-key

# Heartbeat timeout → offline (seconds)
CABLEGUARD_HEARTBEAT_TIMEOUT_SEC=6

# CORS – comma-separated browser origins for local UI
CABLEGUARD_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional future WHEP base (no credentials)
# WHEP_BASE_URL=http://127.0.0.1:8889
